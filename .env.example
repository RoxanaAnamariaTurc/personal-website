# ── OpenTelemetry → Grafana Cloud ─────────────────────────────────────────────
# Get these values from Grafana Cloud → your stack → OpenTelemetry → Configure.
#
# 1. OTLP endpoint (do NOT include /v1/traces – that is appended automatically)
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp

# 2. Base64-encoded credentials: echo -n "<instanceId>:<Cloud API token>" | base64
VITE_OTEL_EXPORTER_OTLP_AUTH=

# ── App metadata ──────────────────────────────────────────────────────────────
VITE_APP_VERSION=0.0.0
