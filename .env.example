# -- OpenTelemetry -> Grafana Cloud -------------------------------------------
# Get these values from Grafana Cloud -> your stack -> OpenTelemetry -> Configure.
# They are read by the Netlify trace proxy, not exposed in the browser bundle.
#
# 1. OTLP endpoint (do not include /v1/traces; the function appends it)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp

# 2. Base64-encoded credentials: echo -n "<instanceId>:<Cloud API token>" | base64
GRAFANA_OTLP_AUTH=

# -- App metadata --------------------------------------------------------------
# This one is public because Vite embeds VITE_* variables in the browser bundle.
VITE_APP_VERSION=0.0.0

# Optional: public/shared Grafana dashboard URL for the career dashboard card.
# Use a public dashboard/snapshot/embed URL that is safe to expose.
VITE_GRAFANA_CAREER_DASHBOARD_URL=https://roxanaturc25.grafana.net/public-dashboards/7af1368d61d34f5abdde3a34ca039ef5
